<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/main_title"
                android:textColor="@color/text"
                android:textSize="28sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/main_language"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="18dp"
            android:text="@string/main_subtitle"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView style="@style/FieldLabel" android:text="@string/host" />

        <EditText
            android:id="@+id/main_host"
            style="@style/Field"
            android:hint="ts.example.com"
            android:inputType="textUri"
            android:singleLine="true" />

        <TextView style="@style/FieldLabel" android:text="@string/port" />

        <EditText
            android:id="@+id/main_port"
            style="@style/Field"
            android:hint="9987"
            android:inputType="number"
            android:singleLine="true" />

        <TextView style="@style/FieldLabel" android:text="@string/nickname" />

        <!-- The tag is a fixed prefix, not part of the text field: it cannot be
             selected, deleted or edited, and the field only holds the bare name. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/main_nickname_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/main_nickname"
                style="@style/Field"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:inputType="textPersonName"
                android:singleLine="true" />
        </LinearLayout>

        <TextView style="@style/FieldLabel" android:text="@string/server_password" />

        <EditText
            android:id="@+id/main_password"
            style="@style/Field"
            android:inputType="textPassword"
            android:singleLine="true" />

        <TextView style="@style/FieldLabel" android:text="@string/channel" />

        <EditText
            android:id="@+id/main_channel"
            style="@style/Field"
            android:hint="Default Channel"
            android:inputType="text"
            android:singleLine="true" />

        <TextView style="@style/FieldLabel" android:text="@string/privilege_key" />

        <EditText
            android:id="@+id/main_token"
            style="@style/Field"
            android:inputType="text"
            android:singleLine="true" />

        <TextView style="@style/FieldLabel" android:text="@string/relay_host" />

        <EditText
            android:id="@+id/main_relay_host"
            style="@style/Field"
            android:hint="relay.example.com (optional)"
            android:inputType="textUri"
            android:singleLine="true" />

        <TextView style="@style/FieldLabel" android:text="@string/relay_port" />

        <EditText
            android:id="@+id/main_relay_port"
            style="@style/Field"
            android:hint="40000"
            android:inputType="number"
            android:singleLine="true" />

        <TextView style="@style/FieldLabel" android:text="@string/relay_token" />

        <EditText
            android:id="@+id/main_relay_token"
            style="@style/Field"
            android:inputType="text"
            android:singleLine="true" />

        <TextView style="@style/FieldLabel" android:text="@string/identity" />

        <EditText
            android:id="@+id/main_identity"
            style="@style/Field"
            android:fontFamily="monospace"
            android:gravity="top|start"
            android:hint="Leave empty to generate a new identity"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="4"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/main_connect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/connect" />

            <Button
                android:id="@+id/main_generate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:text="@string/new_identity" />
        </LinearLayout>

        <TextView
            android:id="@+id/main_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
